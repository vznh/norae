{
  "name": "norae",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first karaoke room with independent lyrics and transcription.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "setup:audio": "node scripts/setup-audio.mjs",
    "test:desktop": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "test:audio": "node scripts/verify-audio.mjs"
  },
  "build": {
    "appId": "app.norae.desktop",
    "productName": "Norae",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music"
    }
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@napi-rs/canvas": "^1.0.10"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
